{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradeops.local/schemas/ml.signal-quality.schema.json",
  "title": "ML Signal Quality Experiment Report",
  "type": "object",
  "required": [
    "experiment_id",
    "dataset_hash",
    "feature_contract_version",
    "feature_names",
    "split",
    "baseline_validation",
    "champion_model",
    "calibration_method",
    "raw_test_metrics",
    "calibrated_test_metrics",
    "probability_status",
    "qualification_reasons",
    "drift",
    "walk_forward_metrics"
  ],
  "properties": {
    "experiment_id": {"type": "string"},
    "dataset_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "feature_contract_version": {"type": "string"},
    "feature_names": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "split": {"type": "object"},
    "baseline_validation": {"type": "array", "minItems": 1},
    "champion_model": {"type": "string"},
    "calibration_method": {"type": "string"},
    "raw_test_metrics": {"type": "object"},
    "calibrated_test_metrics": {"type": "object"},
    "probability_status": {
      "enum": [
        "SCORE_ONLY",
        "CALIBRATED_OUT_OF_SAMPLE",
        "CALIBRATED_OUT_OF_SAMPLE_SYNTHETIC"
      ]
    },
    "qualification_reasons": {"type": "array", "items": {"type": "string"}},
    "drift": {"type": "object"},
    "walk_forward_metrics": {"type": "array"}
  },
  "additionalProperties": false
}
