{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tradeops.local/schemas/decision.proposal.schema.json",
  "title": "DecisionProposal",
  "type": "object",
  "required": ["proposal_id", "correlation_id", "created_at", "expires_at", "execution_mode", "decision", "input", "policy_version", "gate_results", "rationale", "evidence_score", "ml_contribution_used", "human_approval_required", "execution_allowed"],
  "properties": {
    "proposal_id": {"type": "string"},
    "correlation_id": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "execution_mode": {"enum": ["SHADOW", "PAPER"]},
    "decision": {"enum": ["NO_TRADE", "REVIEW_REQUIRED"]},
    "policy_version": {"type": "string"},
    "evidence_score": {"type": "number", "minimum": 0, "maximum": 1},
    "ml_contribution_used": {"type": "boolean"},
    "human_approval_required": {"const": true},
    "execution_allowed": {"const": false},
    "gate_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["gate", "passed", "reason"],
        "properties": {"gate": {"type": "string"}, "passed": {"type": "boolean"}, "reason": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "rationale": {"type": "array", "items": {"type": "string"}},
    "input": {
      "type": "object",
      "required": ["symbol", "direction", "qty", "entry", "stop", "targets", "timeframe", "regime", "pattern", "assessment_status", "risk_status", "event_age_ms", "evidence_quality", "rr", "historical_expectancy_r", "historical_trade_count", "ml_probability_status"],
      "properties": {
        "symbol": {"type": "string"},
        "direction": {"enum": ["LONG", "SHORT"]},
        "qty": {"type": "number", "exclusiveMinimum": 0},
        "entry": {"type": "number", "exclusiveMinimum": 0},
        "stop": {"type": "number", "exclusiveMinimum": 0},
        "targets": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}},
        "timeframe": {"type": "string"},
        "regime": {"type": "string"},
        "pattern": {"type": "string"},
        "assessment_status": {"type": "string"},
        "risk_status": {"type": "string"},
        "event_age_ms": {"type": "number", "minimum": 0},
        "evidence_quality": {"type": "number", "minimum": 0, "maximum": 1},
        "rr": {"type": "number", "exclusiveMinimum": 0},
        "historical_expectancy_r": {"type": "number"},
        "historical_trade_count": {"type": "integer", "minimum": 0},
        "ml_score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "ml_probability_status": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
