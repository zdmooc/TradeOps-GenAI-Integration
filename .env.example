# --- Global ---
ENV=local
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tradeops
POSTGRES_USER=tradeops
POSTGRES_PASSWORD=change-me-locally

# --- Kafka/Redpanda ---
KAFKA_BOOTSTRAP=redpanda:9092

# --- IG market data (demo first; never commit real credentials) ---
IG_ENV=demo
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=

# --- GenAI / RAG ---
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_INPUT_COST_USD_PER_1K=0
LLM_OUTPUT_COST_USD_PER_1K=0

# --- RAG / Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tradeops_kb
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Agent Controller ---
RAG_API_URL=http://rag-api:8014
MCP_SERVER_URL=http://mcp-server:8016

# --- Local static auth (default demonstrator mode) ---
TRADEOPS_AUTH_MODE=static
MCP_AGENT_TOKEN=
MCP_REVIEWER_TOKEN=

# --- OIDC-compatible JWT verification (optional I8 mode) ---
# Production IdP discovery/JWKS refresh is not implemented in I8; pin JWKS JSON securely.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_JSON=
OIDC_ROLE_CLAIM=roles
OIDC_SCOPE_CLAIM=scope
OIDC_REVIEWER_ACCESS_TOKEN=

# --- OpenTelemetry ---
OTEL_SERVICE_NAMESPACE=tradeops
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Gateway ---
KONG_ADMIN_URL=http://kong:8001
