# --- Global ---
ENV=local
LOG_LEVEL=INFO

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tradeops
POSTGRES_USER=tradeops
POSTGRES_PASSWORD=change-me-locally

# --- Kafka/Redpanda ---
KAFKA_BOOTSTRAP=redpanda:9092

# --- IG market data (demo first; never commit real credentials) ---
IG_ENV=demo
IG_API_KEY=
IG_IDENTIFIER=
IG_PASSWORD=
IG_EPIC=CS.D.BITCOIN.CFD.IP

# --- Independent public market source for O3 live multi-source replay ---
KRAKEN_PAIR=XBTUSD
O3_POINTS=20
O3_MAX_SOURCE_AGE_SECONDS=1800

# --- GenAI / RAG ---
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_INPUT_COST_USD_PER_1K=0
LLM_OUTPUT_COST_USD_PER_1K=0

# --- D-090 governed AI access ---
# LLM_PROVIDER=mock remains the safe/offline default.
# Use LLM_PROVIDER=gateway only with the Kong/LiteLLM target profile.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_MODEL_ALIAS=tradeops-default
AI_GATEWAY_AUTH_MODE=static
AI_GATEWAY_ACCESS_TOKEN=
AI_GATEWAY_TIMEOUT_SECONDS=30
AI_ALLOWED_MODEL_ALIASES=tradeops-default

# G2 workload identity. Used when AI_GATEWAY_AUTH_MODE=client_credentials.
AI_OIDC_TOKEN_URL=
AI_OIDC_CLIENT_ID=
AI_OIDC_CLIENT_SECRET=
AI_OIDC_SCOPE=ai.inference
AI_OIDC_AUDIENCE=ai-gateway

# --- RAG / Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tradeops_kb
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Agent Controller / MCP ---
RAG_API_URL=http://rag-api:8014
# Legacy governed HTTP boundary kept for comparison/backward compatibility.
MCP_SERVER_URL=http://mcp-server:8016
# Native MCP v2 Streamable HTTP resource server.
MCP_NATIVE_URL=http://mcp-native:8017/mcp
MCP_NATIVE_RESOURCE_URL=http://mcp-native:8017/mcp

# --- MayaBank IBM MQ read-only operations adapter (R4) ---
# In CRC/OpenShift this is the cross-namespace Service DNS name.
MQ_OPS_API_URL=http://mq-ops-api.mayabank-mq-local.svc.cluster.local:8080
# Local/docker demonstrator may use an env token. OpenShift target should mount a Secret
# and set MQ_OPS_API_TOKEN_FILE instead.
MQ_OPS_API_TOKEN=
MQ_OPS_API_TOKEN_FILE=

# --- Local static auth (default demonstrator mode) ---
TRADEOPS_AUTH_MODE=static
MCP_AGENT_TOKEN=
MCP_REVIEWER_TOKEN=

# --- OIDC-compatible JWT verification ---
# For the demonstrator JWKS JSON is injected. Production should use managed IdP
# discovery/JWKS rotation or token introspection rather than a static pasted JWKS.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_JSON=
OIDC_ROLE_CLAIM=roles
OIDC_SCOPE_CLAIM=scope
OIDC_AGENT_ACCESS_TOKEN=
OIDC_REVIEWER_ACCESS_TOKEN=

# --- OpenTelemetry ---
OTEL_SERVICE_NAMESPACE=tradeops
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Gateway ---
KONG_ADMIN_URL=http://kong:8001
